def ta_var_kernel(series: Doubles, finite: Flags, window: int, /) -> Doubles: ...
def ema_smooth_run(run: Doubles, periods: int, alpha: float, /) -> Doubles: ...
def wilder_smooth_run(run: Doubles, periods: int, /) -> Doubles: ...
def wilder_rsi_smooth_run(run: Doubles, periods: int, /) -> Doubles: ...
def wilder_sum_run(run: Doubles, periods: int, /) -> Doubles: ...
def ema_fma_at_run(run: Doubles, periods: int, seed_offset: int, /) -> Doubles: ...
def wilder_adx_smooth_run(run: Doubles, periods: int, /) -> Doubles: ...
def cumulative_within_session_kernel(series: Doubles, resets: Doubles, /) -> Doubles: ...
def cci_kernel(typical_price: Doubles, start: int, period: int, /) -> Doubles: ...
def dx_kernel(plus_di: Doubles, minus_di: Doubles, /) -> Doubles: ...
def money_flow_index_kernel(
    finite: Flags, positive_money_flow: Doubles, negative_money_flow: Doubles, period: int, /
